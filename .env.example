# Copy this file to .env and fill in only the values you need.
# Never commit .env, and never paste real keys into a notebook.

# --- Chapter 1: Gemini (free track) ---
GOOGLE_API_KEY=

# --- Chapters 4, 6, and 7: OpenAI (API track) ---
OPENAI_API_KEY=

# --- Chapters 4 and 7: Anthropic (optional) ---
ANTHROPIC_API_KEY=

# --- Chapter 6: LangSmith ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=agentic-ai-handbook

# --- Chapter 7: LiteLLM gateway ---
# The master key is for local administration only. Issue virtual keys to apps.
LITELLM_MASTER_KEY=sk-local-admin-key
# Use a long, stable, random value. Do not reuse the master key.
LITELLM_SALT_KEY=

# --- Chapter 3: optional PageIndex SDK ---
PAGEINDEX_API_KEY=

# --- Optional: Ollama endpoint (defaults to http://localhost:11434) ---
OLLAMA_HOST=
